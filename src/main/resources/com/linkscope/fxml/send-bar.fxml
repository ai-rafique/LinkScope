<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Shared payload/send row. Included by every module tab; see SendBarController. -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.core.ui.SendBarController"
      spacing="8" alignment="CENTER_LEFT" styleClass="send-bar">
    <TextField fx:id="payloadField" HBox.hgrow="ALWAYS"
               promptText="Payload — Enter to send, Up/Down for history"/>
    <HBox alignment="CENTER_LEFT">
        <ToggleButton fx:id="asciiToggle" text="ASCII" styleClass="left-pill"/>
        <ToggleButton fx:id="hexToggle" text="HEX" styleClass="right-pill"/>
    </HBox>
    <ComboBox fx:id="lineEnding" prefWidth="88"/>
    <Button fx:id="sendButton" text="Send" styleClass="accent">
        <graphic>
            <FontIcon iconLiteral="fth-send"/>
        </graphic>
        <tooltip>
            <Tooltip text="Send the payload (Enter)"/>
        </tooltip>
    </Button>
</HBox>
