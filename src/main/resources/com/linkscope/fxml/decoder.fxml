<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.decoder.DecoderController" styleClass="ls-module">
    <!-- Input -->
    <VBox styleClass="ls-panel">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Bytes" styleClass="ls-panel-title"/>
            <HBox alignment="CENTER_LEFT">
                <ToggleButton fx:id="hexInputToggle" text="Hex" styleClass="left-pill">
                    <tooltip><Tooltip text="Hex bytes with any separators: 01 02 ff, 0102ff, 0x01,0x02"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="asciiInputToggle" text="ASCII" styleClass="center-pill">
                    <tooltip><Tooltip text="Text, with \n \r \t \xNN escapes"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="base64InputToggle" text="Base64" styleClass="right-pill"/>
            </HBox>
            <Label fx:id="inputStatusLabel" styleClass="text-muted, small"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="clearButton" text="Clear" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
            </Button>
        </HBox>
        <TextArea fx:id="inputArea" prefRowCount="3" wrapText="true" styleClass="ls-mono"
                  promptText="Paste bytes here, or right-click a log line and choose Send to Decoder"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Layout" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="layoutField" HBox.hgrow="ALWAYS" promptText="2 3 5 6 4    (widths in bytes; hints: 4f 2i 2u 5s 3x *; groups: [2 4]*3)">
                <tooltip><Tooltip text="Field widths in bytes, in order. Add a type hint: 4f float, 2i signed, 2u unsigned, 5s string, 3x skip. * takes the rest. [2 4]*3 repeats a group; [2 4]* repeats while bytes remain."/></tooltip>
            </TextField>
            <HBox alignment="CENTER_LEFT">
                <ToggleButton fx:id="littleEndianToggle" text="LE first" styleClass="left-pill">
                    <tooltip><Tooltip text="Show little-endian readings first (Intel, most MCUs)"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="bigEndianToggle" text="BE first" styleClass="right-pill">
                    <tooltip><Tooltip text="Show big-endian readings first (network order, Modbus)"/></tooltip>
                </ToggleButton>
            </HBox>
        </HBox>
        <Label fx:id="layoutStatusLabel" styleClass="text-muted, small" wrapText="true"/>
        <TextArea fx:id="groupedDumpArea" prefRowCount="2" editable="false" wrapText="true" styleClass="ls-mono">
            <tooltip><Tooltip text="The bytes grouped per field, in layout order"/></tooltip>
        </TextArea>
    </VBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.6" VBox.vgrow="ALWAYS">
        <TableView fx:id="fieldsTable" minHeight="120">
            <columns>
                <TableColumn fx:id="indexColumn" text="Field" prefWidth="60"/>
                <TableColumn fx:id="offsetColumn" text="Offset" prefWidth="90"/>
                <TableColumn fx:id="lengthColumn" text="Len" prefWidth="70"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="70"/>
                <TableColumn fx:id="hexColumn" text="Hex" prefWidth="220"/>
                <TableColumn fx:id="valueColumn" text="Value" prefWidth="520"/>
            </columns>
        </TableView>
        <TableView fx:id="detailTable" minHeight="90">
            <columns>
                <TableColumn fx:id="detailNameColumn" text="Selected field as" prefWidth="180"/>
                <TableColumn fx:id="detailValueColumn" text="Value" prefWidth="600"/>
            </columns>
        </TableView>
    </SplitPane>

    <Label styleClass="ls-hint" wrapText="true"
           text="Cut a payload into fields and read each one every plausible way. Plain widths decode as unsigned, signed, float and text where the size allows; hints pin a type. Save the input and layout as a preset to recall a device's format by name."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
