<?xml version="1.0" encoding="UTF-8"?>

<?import com.linkscope.core.ui.StatusBadge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.portscan.PortScanController" styleClass="ls-module">
    <VBox styleClass="ls-panel">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Local TCP ports" styleClass="ls-panel-title"/>
            <Label fx:id="summaryLabel" styleClass="text-muted, small"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <StatusBadge fx:id="statusBadge"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Interface" styleClass="text-muted" minWidth="-Infinity"/>
            <ComboBox fx:id="addressCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="200">
                <tooltip><Tooltip text="Address to probe. Loopback also sees services bound to all interfaces (0.0.0.0). Opening the list rescans the adapters."/></tooltip>
            </ComboBox>
            <Button fx:id="refreshButton" styleClass="button-icon">
                <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                <tooltip><Tooltip text="Rescan network interfaces"/></tooltip>
            </Button>
            <Label text="Ports" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="rangeField" text="1-1024" prefWidth="200" minWidth="120">
                <tooltip><Tooltip text="Ranges and lists: 1-1024, 22,80,443, 8000-9000,3306. Up to 1-65535."/></tooltip>
            </TextField>
            <MenuButton fx:id="presetsButton" text="Ranges" styleClass="small" minWidth="-Infinity">
                <tooltip><Tooltip text="Common port ranges"/></tooltip>
            </MenuButton>
            <Button fx:id="scanButton" text="Scan" styleClass="accent" minWidth="-Infinity"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Ports I need" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="neededField" promptText="502, 1883, 16000-16010" prefWidth="220" minWidth="140">
                <tooltip><Tooltip text="The ports your own software wants. Check scans just these and says for each whether it is free, or taken and by whom. They are also ringed on the grid."/></tooltip>
            </TextField>
            <Button fx:id="checkButton" text="Check" styleClass="small" minWidth="-Infinity">
                <graphic><FontIcon iconLiteral="fth-check-circle"/></graphic>
            </Button>
            <FlowPane fx:id="verdictBox" hgap="6" vgap="4" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0"/>
    </VBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <ToggleButton fx:id="listeningTile" text="0  listening" selected="true" styleClass="ls-state-tile, tile-listening">
            <tooltip><Tooltip text="A server accepts connections on the port. Click to show or hide these rows."/></tooltip>
        </ToggleButton>
        <ToggleButton fx:id="inUseTile" text="0  in use" selected="true" styleClass="ls-state-tile, tile-inuse">
            <tooltip><Tooltip text="Bound without a listener, for example an established connection. Click to show or hide."/></tooltip>
        </ToggleButton>
        <ToggleButton fx:id="reservedTile" text="0  reserved" selected="true" styleClass="ls-state-tile, tile-reserved">
            <tooltip><Tooltip text="The OS refuses the bind: Windows excluded port ranges, or ports below 1024 without root. Click to show or hide."/></tooltip>
        </ToggleButton>
        <ToggleButton fx:id="unknownTile" text="0  unknown" selected="true" styleClass="ls-state-tile, tile-unknown">
            <tooltip><Tooltip text="Neither test gave a clear answer (timeouts, odd errors). Click to show or hide."/></tooltip>
        </ToggleButton>
        <ToggleButton fx:id="freeTile" text="0  free" styleClass="ls-state-tile, tile-free">
            <tooltip><Tooltip text="Nothing there. Hidden by default; click to show them as ranges."/></tooltip>
        </ToggleButton>
        <Pane HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="port number or process name" prefWidth="220">
            <tooltip><Tooltip text="Filter rows: a port number finds the row that contains it; text matches process, service and state"/></tooltip>
        </TextField>
    </HBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.5" VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="ls-flat-scroll">
            <VBox fx:id="gridHost">
                <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
            </VBox>
        </ScrollPane>
        <TableView fx:id="table" minHeight="100">
            <columns>
                <TableColumn fx:id="portColumn" text="Port(s)" prefWidth="130"/>
                <TableColumn fx:id="stateColumn" text="State" prefWidth="170"/>
                <TableColumn fx:id="serviceColumn" text="Service" prefWidth="150"/>
                <TableColumn fx:id="ownerColumn" text="Process" prefWidth="240"/>
                <TableColumn fx:id="detailColumn" text="Detail" prefWidth="320"/>
            </columns>
        </TableView>
    </SplitPane>

    <Label styleClass="ls-hint" wrapText="true"
           text="Blocks of 256 ports show how many are occupied inside; click one to see its ports. Green listening, amber in use, red reserved, hollow free. Ringed cells are the ports you need."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
