<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!-- Payload inspector: hex dump + decoders for the selected log line. See InspectorController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.core.ui.InspectorController" styleClass="ls-inspector" spacing="8" minWidth="420">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Inspector" styleClass="ls-section-title"/>
        <Label fx:id="headerLabel" styleClass="text-muted, small"/>
    </HBox>
    <TextArea fx:id="dumpArea" editable="false" wrapText="false" prefRowCount="6" styleClass="ls-mono" VBox.vgrow="SOMETIMES">
        <tooltip><Tooltip text="Select bytes here (hex or ASCII column) to decode them below"/></tooltip>
    </TextArea>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Offset" styleClass="text-muted"/>
        <TextField fx:id="offsetField" prefWidth="64"/>
        <Label text="Length" styleClass="text-muted"/>
        <TextField fx:id="lengthField" prefWidth="64"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="selectionLabel" styleClass="text-muted, small"/>
    </HBox>
    <TableView fx:id="decodedTable" VBox.vgrow="ALWAYS" minHeight="100">
        <columns>
            <TableColumn fx:id="nameColumn" text="As" prefWidth="170"/>
            <TableColumn fx:id="valueColumn" text="Value" prefWidth="380"/>
        </columns>
    </TableView>
</VBox>
