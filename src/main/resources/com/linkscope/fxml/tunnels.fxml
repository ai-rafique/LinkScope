<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.tunnels.TunnelsController" styleClass="ls-module">
    <fx:include fx:id="connection" source="ssh-connection.fxml"/>

    <!-- New forward -->
    <VBox styleClass="ls-panel">
        <Label text="Forward" styleClass="ls-panel-title"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="typeCombo" prefWidth="130">
                <tooltip><Tooltip text="Local: a port on this PC reaches a host behind the server. Remote: a port on the server reaches a host near this PC."/></tooltip>
            </ComboBox>
            <Label text="Bind" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="bindAddressField" prefWidth="120"/>
            <Label text=":" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="bindPortField" prefWidth="110"/>
            <Label text="→" minWidth="-Infinity"/>
            <TextField fx:id="targetHostField" HBox.hgrow="ALWAYS"/>
            <Label text=":" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="targetPortField" prefWidth="110"/>
            <Button fx:id="addButton" text="Add" styleClass="accent">
                <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                <tooltip><Tooltip text="Add the forward; it starts right away when the session is connected"/></tooltip>
            </Button>
        </HBox>
    </VBox>

    <!-- Forwards -->
    <VBox spacing="4" VBox.vgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Forwards" styleClass="ls-section-title"/>
            <Label fx:id="summaryLabel" styleClass="text-muted, small"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="startButton" text="Start" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-play"/></graphic>
            </Button>
            <Button fx:id="stopButton" text="Stop" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-square"/></graphic>
            </Button>
            <Button fx:id="removeButton" text="Remove" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
            </Button>
            <Button fx:id="startAllButton" text="Start all" styleClass="small"/>
            <Button fx:id="stopAllButton" text="Stop all" styleClass="small"/>
        </HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" minHeight="120">
            <columns>
                <TableColumn fx:id="activeColumn" text="Active" prefWidth="70"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="80"/>
                <TableColumn fx:id="bindColumn" text="Listens on" prefWidth="220"/>
                <TableColumn fx:id="targetColumn" text="Delivers to" prefWidth="300"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="320"/>
            </columns>
        </TableView>
    </VBox>

    <Label styleClass="ls-hint" wrapText="true"
           text="Example: Local, bind 127.0.0.1:14222 → nats-box:4222 makes a NATS server behind the SSH host reachable as localhost:14222 on the NATS tab. Forwards saved in a preset reconnect automatically when the session comes back."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
