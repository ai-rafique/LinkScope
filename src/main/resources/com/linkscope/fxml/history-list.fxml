<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Shared request history list. See HistoryListController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.core.ui.HistoryListController" styleClass="ls-panel" spacing="8">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" text="History" styleClass="ls-panel-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearButton" styleClass="button-icon, small">
            <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
        </Button>
    </HBox>
    <ListView fx:id="list" VBox.vgrow="ALWAYS" minHeight="120"/>
</VBox>
