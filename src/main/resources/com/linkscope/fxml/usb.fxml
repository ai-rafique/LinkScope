<?xml version="1.0" encoding="UTF-8"?>

<?import com.linkscope.core.ui.StatusBadge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.usb.UsbController" styleClass="ls-module">
    <VBox styleClass="ls-panel">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="USB" styleClass="ls-panel-title"/>
            <Label fx:id="hubHint" styleClass="text-muted, small"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <StatusBadge fx:id="statusBadge"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Root hub" styleClass="text-muted" minWidth="-Infinity"/>
            <ComboBox fx:id="hubCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="200" promptText="Listing root hubs…">
                <tooltip><Tooltip text="One entry per USB host controller. Devices hang off a root hub; pick the hub that lists the device you want."/></tooltip>
            </ComboBox>
            <Button fx:id="refreshButton" styleClass="button-icon">
                <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                <tooltip><Tooltip text="Rescan root hubs and devices"/></tooltip>
            </Button>
            <Button fx:id="startButton" text="Start" styleClass="accent" minWidth="-Infinity">
                <tooltip><Tooltip text="Needs administrator rights: USBPcap asks Windows for them when the capture starts (UAC prompt), unless LinkScope already runs elevated."/></tooltip>
            </Button>
        </HBox>
        <HBox spacing="12" alignment="TOP_LEFT">
            <ListView fx:id="deviceList" HBox.hgrow="ALWAYS" prefHeight="140" minHeight="72">
                <tooltip><Tooltip text="Tick the devices to capture. The number is the device address on this hub; what follows are its interfaces and child devices."/></tooltip>
            </ListView>
            <VBox spacing="8" minWidth="-Infinity">
                <CheckBox fx:id="allDevicesCheck" text="All devices on this hub">
                    <tooltip><Tooltip text="Capture everything on the hub, including devices plugged in later. Includes keyboards and mice."/></tooltip>
                </CheckBox>
                <CheckBox fx:id="descriptorsCheck" text="Include descriptors" selected="true">
                    <tooltip><Tooltip text="Emit the descriptors of already connected devices at the start, so the capture shows what each device is even without a replug."/></tooltip>
                </CheckBox>
                <Button fx:id="usb3Button" text="Enable USB 3.0 capture" styleClass="small">
                    <tooltip><Tooltip text="Runs USBPcapCMD -I as administrator once. Needed when a USB 3.0 hub shows no devices."/></tooltip>
                </Button>
            </VBox>
        </HBox>
        <Label fx:id="keyboardWarning" styleClass="ls-warning-text, small" visible="false" managed="false"
               text="The selection includes a keyboard: this capture will contain keystrokes."/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Display filter" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="displayFilterField" HBox.hgrow="ALWAYS" styleClass="ls-mono"
                       promptText="usb.addr == 1.5      bulk      usb.endpoint == 1 and usb.dir == in      contains 0x0103      usb.status != success">
                <tooltip><Tooltip text="Filters the table as you type. Fields: usb.addr usb.bus usb.device usb.endpoint usb.dir usb.type usb.function usb.status usb.stage usb.request len info. Bare words: bulk control interrupt isoch in out. Combine with and / or / not and parentheses."/></tooltip>
            </TextField>
            <Label fx:id="filterStatusLabel" styleClass="text-muted, small"/>
            <ToggleButton fx:id="followToggle" text="Follow" selected="true" styleClass="small">
                <tooltip><Tooltip text="Keep the newest record in view while nothing is selected"/></tooltip>
            </ToggleButton>
            <Button fx:id="openButton" text="Open…" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-folder"/></graphic>
                <tooltip><Tooltip text="Load a USBPcap .pcap file (as saved by Wireshark or this tab)"/></tooltip>
            </Button>
            <Button fx:id="saveButton" text="Save…" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-download"/></graphic>
                <tooltip><Tooltip text="Save the shown records as .pcap (opens in Wireshark)"/></tooltip>
            </Button>
            <Button fx:id="clearButton" text="Clear" styleClass="small">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
            </Button>
        </HBox>
        <Label fx:id="statsLabel" styleClass="text-muted, small"/>
    </VBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" minHeight="120">
            <columns>
                <TableColumn fx:id="numberColumn" text="No." prefWidth="64"/>
                <TableColumn fx:id="timeColumn" text="Time" prefWidth="96"/>
                <TableColumn fx:id="srcColumn" text="Source" prefWidth="90"/>
                <TableColumn fx:id="dstColumn" text="Destination" prefWidth="90"/>
                <TableColumn fx:id="typeColumn" text="Transfer" prefWidth="84"/>
                <TableColumn fx:id="lengthColumn" text="Data" prefWidth="60"/>
                <TableColumn fx:id="infoColumn" text="Info" prefWidth="520"/>
            </columns>
        </TableView>
        <TextArea fx:id="detailArea" editable="false" wrapText="false" styleClass="ls-mono" minHeight="90"
                  promptText="Select a record to see the URB, setup packet or descriptors, and the data hex dump."/>
    </SplitPane>

    <Label styleClass="ls-hint" wrapText="true"
           text="Records every transfer between Windows and the ticked devices, below the driver, so it shows what any program sends over USB. Right-click a record to filter or decode it."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
