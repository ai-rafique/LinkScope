<?xml version="1.0" encoding="UTF-8"?>

<?import com.linkscope.core.ui.StatusBadge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.hid.HidController" styleClass="ls-module">
    <VBox styleClass="ls-panel">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="HID" styleClass="ls-panel-title"/>
            <Label fx:id="deviceHint" styleClass="text-muted, small"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <StatusBadge fx:id="statusBadge"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Device" styleClass="text-muted" minWidth="-Infinity"/>
            <ComboBox fx:id="deviceCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="240" promptText="Listing devices…">
                <tooltip><Tooltip text="Game controllers first. Xbox controllers appear twice: the XInput entry gives separate triggers and rumble, the HID entry shows the raw gamepad interface. Opening the list rescans."/></tooltip>
            </ComboBox>
            <Button fx:id="refreshButton" styleClass="button-icon">
                <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                <tooltip><Tooltip text="Rescan devices"/></tooltip>
            </Button>
            <Button fx:id="openButton" text="Open" styleClass="accent" minWidth="-Infinity"/>
        </HBox>
        <Label fx:id="infoLabel" styleClass="text-muted, small" wrapText="true"/>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="ls-flat-scroll">
        <VBox fx:id="viewHost" spacing="8">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
            <Label text="Open a device and press its buttons: they light up here as you hold them, sticks move the dots, triggers fill the bars."
                   styleClass="text-muted" wrapText="true"/>
        </VBox>
    </ScrollPane>

    <VBox styleClass="ls-panel" spacing="8">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Raw report" styleClass="text-muted" minWidth="-Infinity"/>
            <Label fx:id="rawLabel" styleClass="ls-mono, small" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="decodeButton" text="To Decoder" styleClass="small" minWidth="-Infinity">
                <graphic><FontIcon iconLiteral="fth-columns"/></graphic>
                <tooltip><Tooltip text="Open the latest report in the Decoder to lay out its bytes"/></tooltip>
            </Button>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="rateLabel" styleClass="text-muted, small"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="summaryLabel" styleClass="text-muted, small"/>
            <CheckBox fx:id="logCheck" text="Log every report">
                <tooltip><Tooltip text="Write each report to the shared log as RX with the held buttons and moved axes. Gamepads send 125-250 per second, so leave this off unless you need the trace."/></tooltip>
            </CheckBox>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Rumble" styleClass="text-muted" minWidth="-Infinity">
                <tooltip><Tooltip text="Xbox controllers through XInput. Left is the heavy low-frequency motor, right the light high-frequency one."/></tooltip>
            </Label>
            <Label text="left" styleClass="text-muted, small" minWidth="-Infinity"/>
            <Slider fx:id="leftSlider" min="0" max="100" value="0" prefWidth="160" disable="true"/>
            <Label text="right" styleClass="text-muted, small" minWidth="-Infinity"/>
            <Slider fx:id="rightSlider" min="0" max="100" value="0" prefWidth="160" disable="true"/>
            <Button fx:id="pulseButton" text="Pulse" styleClass="small" disable="true">
                <graphic><FontIcon iconLiteral="fth-zap"/></graphic>
                <tooltip><Tooltip text="Both motors at full for half a second, then back to the slider levels"/></tooltip>
            </Button>
            <Button fx:id="rumbleStopButton" text="Stop" styleClass="small" disable="true"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Output report" styleClass="text-muted" minWidth="-Infinity">
                <tooltip><Tooltip text="For HID devices that accept output reports (LEDs, force feedback, vendor commands): hex bytes, report id first."/></tooltip>
            </Label>
            <TextField fx:id="outputField" prefWidth="220" styleClass="ls-mono" disable="true" promptText="hex, report id first"/>
            <Button fx:id="sendOutputButton" text="Send" styleClass="small" disable="true"/>
        </HBox>
    </VBox>

    <Label styleClass="ls-hint" wrapText="true"
           text="Reads the device the way Windows sees it, so a button that never lights here is not reaching the OS. Keyboards and mice are exclusive to Windows and cannot be opened."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
