<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.ssh.SshController" styleClass="ls-module">
    <fx:include fx:id="connection" source="ssh-connection.fxml"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Console -->
        <VBox styleClass="ls-panel" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Console" styleClass="ls-panel-title"/>
                <HBox alignment="CENTER_LEFT">
                    <ToggleButton fx:id="shellModeToggle" text="Shell" styleClass="left-pill">
                        <tooltip><Tooltip text="Lines go to the interactive login shell (prompts, cd, environment persist)"/></tooltip>
                    </ToggleButton>
                    <ToggleButton fx:id="execModeToggle" text="Exec" styleClass="right-pill">
                        <tooltip><Tooltip text="Each command runs on its own channel; output and exit status are captured"/></tooltip>
                    </ToggleButton>
                </HBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="ctrlCButton" text="Ctrl+C" styleClass="small">
                    <tooltip><Tooltip text="Send an interrupt (0x03) to the shell"/></tooltip>
                </Button>
                <Button fx:id="clearConsoleButton" text="Clear" styleClass="small">
                    <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                </Button>
            </HBox>
            <TextArea fx:id="consoleArea" editable="false" wrapText="true" styleClass="ls-mono, ls-console" VBox.vgrow="ALWAYS"
                      promptText="Shell output appears here. Colours and cursor control are stripped; this is a line console, not a full terminal."/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="commandField" HBox.hgrow="ALWAYS" styleClass="ls-mono"
                           promptText="Type a line for the interactive shell, Enter to send, Up/Down for history"/>
                <Button fx:id="sendButton" text="Send" styleClass="accent">
                    <graphic><FontIcon iconLiteral="fth-send"/></graphic>
                </Button>
            </HBox>
        </VBox>
        <fx:include fx:id="history" source="history-list.fxml" minWidth="240" prefWidth="280"/>
    </HBox>

    <Label styleClass="ls-hint" wrapText="true"
           text="Simple SSH: connect with a password or key, type into the shell or run single commands with captured exit codes. Every byte in and out is also in the shared log under SSH. Tunnels and SFTP can reuse this connection."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
