<?xml version="1.0" encoding="UTF-8"?>

<?import com.linkscope.core.ui.StatusBadge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.linkscope.modules.ssh.SshController" styleClass="ls-module">
    <!-- Connection -->
    <VBox styleClass="ls-panel">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Connection" styleClass="ls-panel-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <StatusBadge fx:id="statusBadge"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Host" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="hostField" HBox.hgrow="ALWAYS" promptText="hostname or IP, or ${SSH_HOST}"/>
            <Label text="Port" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="portField" text="22" prefWidth="64"/>
            <Label text="User" styleClass="text-muted" minWidth="-Infinity"/>
            <TextField fx:id="userField" prefWidth="140" promptText="user"/>
            <Button fx:id="connectButton" text="Connect" styleClass="accent"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Auth" styleClass="text-muted" minWidth="-Infinity"/>
            <HBox alignment="CENTER_LEFT">
                <ToggleButton fx:id="passwordAuthToggle" text="Password" styleClass="left-pill"/>
                <ToggleButton fx:id="keyAuthToggle" text="Private key" styleClass="right-pill"/>
            </HBox>
            <HBox fx:id="passwordBox" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" promptText="password, or ${SSH_PASSWORD} from .env"/>
            </HBox>
            <HBox fx:id="keyBox" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <TextField fx:id="keyPathField" HBox.hgrow="ALWAYS" promptText="~/.ssh/id_ed25519 (OpenSSH or PEM format)"/>
                <Button fx:id="browseKeyButton" styleClass="button-icon">
                    <graphic><FontIcon iconLiteral="fth-folder"/></graphic>
                    <tooltip><Tooltip text="Choose a private key file"/></tooltip>
                </Button>
                <PasswordField fx:id="passphraseField" prefWidth="160" promptText="passphrase (if any)"/>
            </HBox>
            <CheckBox fx:id="strictHostKeyCheck" text="Strict host key">
                <tooltip><Tooltip text="On: refuse hosts not already in ~/.linkscope/known_hosts. Off (default): accept a new host key, remember it, and log its fingerprint."/></tooltip>
            </CheckBox>
        </HBox>
    </VBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Console -->
        <VBox styleClass="ls-panel" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Console" styleClass="ls-panel-title"/>
                <HBox alignment="CENTER_LEFT">
                    <ToggleButton fx:id="shellModeToggle" text="Shell" styleClass="left-pill">
                        <tooltip><Tooltip text="Lines go to the interactive login shell (prompts, cd, environment persist)"/></tooltip>
                    </ToggleButton>
                    <ToggleButton fx:id="execModeToggle" text="Exec" styleClass="right-pill">
                        <tooltip><Tooltip text="Each command runs on its own channel; output and exit status are captured"/></tooltip>
                    </ToggleButton>
                </HBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="ctrlCButton" text="Ctrl+C" styleClass="small">
                    <tooltip><Tooltip text="Send an interrupt (0x03) to the shell"/></tooltip>
                </Button>
                <Button fx:id="clearConsoleButton" text="Clear" styleClass="small">
                    <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                </Button>
            </HBox>
            <TextArea fx:id="consoleArea" editable="false" wrapText="true" styleClass="ls-mono, ls-console" VBox.vgrow="ALWAYS"
                      promptText="Shell output appears here. Colours and cursor control are stripped; this is a line console, not a full terminal."/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="commandField" HBox.hgrow="ALWAYS" styleClass="ls-mono"
                           promptText="Type a line for the interactive shell, Enter to send, Up/Down for history"/>
                <Button fx:id="sendButton" text="Send" styleClass="accent">
                    <graphic><FontIcon iconLiteral="fth-send"/></graphic>
                </Button>
            </HBox>
        </VBox>
        <fx:include fx:id="history" source="history-list.fxml" minWidth="240" prefWidth="280"/>
    </HBox>

    <Label styleClass="ls-hint" wrapText="true"
           text="Simple SSH: connect with a password or key, type into the shell or run single commands with captured exit codes. Every byte in and out is also in the shared log under SSH. Passwords are only saved in presets as ${VAR} placeholders."/>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
