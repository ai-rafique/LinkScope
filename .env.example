# LinkScope environment placeholders.
# Copy to .env (git-ignored) and fill in. Any string field in a saved preset may
# reference these as ${VAR_NAME}; PresetStore resolves them from .env first, then
# from the process environment. Unset variables are flagged [UNSET: VAR_NAME] in
# the log rather than sent literally.
#
# Defaults below match the local Docker Compose broker stack (docker compose up -d).

# NATS
NATS_SERVERS=nats://localhost:4222

# Kafka (Redpanda locally) — bootstrap.servers
KAFKA_BROKERS=localhost:9092

# MQTT (Mosquitto)
MQTT_BROKER=localhost:1883
MQTT_WS_BROKER=ws://localhost:9001

# Serial — a COMn port on Windows, /dev/ttyUSBn or /dev/pts/n elsewhere
SERIAL_PORT=COM1

# HTTP tester (v2) — bearer token placeholder, never commit a real one
API_BASE_URL=http://localhost:8080
API_TOKEN=changeme
